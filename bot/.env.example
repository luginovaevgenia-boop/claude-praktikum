# Токен от @BotFather
BOT_TOKEN=
# Робокасса: личный кабинет -> Магазины -> Технические настройки
ROBOKASSA_LOGIN=        # идентификатор магазина
ROBOKASSA_PASS1=        # Пароль #1 (для ссылки на оплату)
ROBOKASSA_PASS2=        # Пароль #2 (для проверки уведомления об оплате)
ROBOKASSA_HASH=md5      # алгоритм подписи, как выбрано в настройках магазина (md5/sha256)
ROBOKASSA_TEST=1        # 1 - тестовые платежи, 0 - боевые
# Порт веб-сервера для уведомлений Робокассы
PORT=8080
# Ссылка-приглашение в WhatsApp-группу (выдаётся только после оплаты)
WHATSAPP_GROUP_LINK=
# Ваш Telegram ID (узнать у @userinfobot) - сюда придёт уведомление о каждой оплате
ADMIN_ID=
# Предоплата в рублях
PRICE_RUB=5000
