# Токен от @BotFather
BOT_TOKEN=
# Токен платёжного провайдера: @BotFather -> Bot Settings -> Payments -> ЮKassa (или другой)
PROVIDER_TOKEN=
# Ссылка-приглашение в WhatsApp-группу (выдаётся только после оплаты)
